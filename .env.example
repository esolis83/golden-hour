# ── Spotify ───────────────────────────────────────────────────────────────────
# Client ID is public — safe in the frontend build.
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# URL of the PHP token proxy (keeps Client Secret server-side).
# In production: same-origin path on Hostinger — no CORS needed.
# In local dev:  leave blank to skip auto-connect, or point to your
#                deployed PHP file (e.g. https://golden-hour.enriquesolis.me/api/spotify-token.php)
VITE_SPOTIFY_TOKEN_URL=/api/spotify-token.php

# Local dev only — used by useSpotifyAuth (PKCE flow) for local testing.
# Not needed in production (PHP proxy handles auth instead).
VITE_REDIRECT_URI=http://127.0.0.1:5173/
